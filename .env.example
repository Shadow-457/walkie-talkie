# Walkie-Talkie desktop app configuration.
# The app reads these from the PROCESS ENVIRONMENT (there is no .env loader
# and no third-party dependency for it). Export them before launching, e.g.:
#
#   WT_PORT=9000 python main.py
#
# Do not commit real secrets — this project needs none today.

# MCP bind address. Keep 127.0.0.1 unless agents run on other machines.
WT_HOST=127.0.0.1

# MCP port. Change it if 8765 is already taken.
WT_PORT=8765
